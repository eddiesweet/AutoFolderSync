<Window x:Class="IndustrialBackup.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로그램 정보" Height="280" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Auto Folder Sync" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Version 1.0 (MIT License)" Foreground="Gray" FontSize="12" Margin="0,0,0,12"/>

            <TextBlock Text="지정한 원본 폴더의 데이터를 백업 폴더로 자동 동기화하여 안전하게 보호합니다." 
                       TextWrapping="Wrap" FontSize="13" Margin="0,0,0,15"/>

            <!-- 깃허브 링크 -->
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="GitHub: " FontWeight="Bold" Width="70"/>
                <TextBlock>
                    <Hyperlink NavigateUri="https://github.com/eddiesweet" RequestNavigate="Hyperlink_RequestNavigate">
                        https://github.com/eddiesweet
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- 블로그 링크 -->
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="Blog: " FontWeight="Bold" Width="70"/>
                <TextBlock>
                    <Hyperlink NavigateUri="https://blog.naver.com/edjo" RequestNavigate="Hyperlink_RequestNavigate">
                        blog.naver.com/edjo
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- 확인 버튼 -->
            <Button Content="확인" Width="80" Height="28" HorizontalAlignment="Right" Margin="0,20,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>